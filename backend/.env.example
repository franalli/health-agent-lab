# Secrets + runtime config ONLY. Clinical thresholds never live here — they belong in
# config.py (versioned, auditable). Copy this file to `.env` (git-ignored) and fill in.

# Required for Mode 2 (LLM compose) and the input gate classifier.
# Mode 1 (deterministic) runs fully without it.
ANTHROPIC_API_KEY=

# SQLite database file. Created by `make init-db`; seeded by `make seed`.
# On the hosted deploy this points at the persistent disk (e.g. /data/health.db).
DATABASE_PATH=./data/health.db

# Optional: stream eval runs to the offline LangSmith trace sink (synthetic data only).
# Leave unset to keep the sink off; the local report stays canonical.
# LANGSMITH_API_KEY=
