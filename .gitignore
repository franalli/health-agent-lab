.env
*.env
.remember

# Python / uv
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / npm
node_modules/
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
*.swp

# Console printouts / captured logs (local debugging artifacts, never committed)
console-*
page-*

# SQLite database + WAL sidecars (generated by init-db; synthetic but regenerable, never committed)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# Cross-process advisory locks — ephemeral 0-byte flock files beside the DB, one per db.process_lock
# domain (<db>.<name>.lock: startup · learn · data); regenerable, never committed. See db.process_lock.
*.db.*.lock

# Evaluation reports (regenerated by `make eval`; the JSON regression artifact is reproducible, not committed)
backend/eval/reports/

# Runtime-uploaded dataset folders (POST /members/upload writes these under backend/data/; ephemeral,
# like health.db). The shipped training_data/ is already tracked, so this never untracks it; the explicit
# negation keeps it obvious. Force-add (git add -f) a folder here only to intentionally ship a new dataset.
backend/data/*/
!backend/data/training_data/
backend/data/eval_data.zip
backend/data/upload_test.zip
